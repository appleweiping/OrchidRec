{
  "schema_version": 1,
  "seed": 2026,
  "data": {
    "path": "interactions.json",
    "format": "orchidrec-json",
    "minimum_rating": null
  },
  "split": {
    "method": "leave_one_out",
    "test_ratio": 0.2
  },
  "evaluation": {
    "k": 3,
    "exclude_seen": true,
    "bootstrap_samples": 20,
    "confidence": 0.9
  },
  "tuning": {
    "selection_metric": "ndcg",
    "direction": "maximize",
    "validation_split": {
      "method": "leave_one_out",
      "validation_ratio": 0.2
    },
    "implicit_mf_seeds": [2026, 2027]
  },
  "models": [
    {
      "label": "popularity",
      "name": "popularity",
      "params": {},
      "grid": {"weighted": [false, true]}
    },
    {
      "label": "item-knn",
      "name": "item_knn",
      "params": {},
      "grid": {"neighbors": [3, 5], "shrinkage": [0.0, 1.0]}
    },
    {
      "label": "bpr-mf",
      "name": "implicit_mf",
      "params": {"negative_samples": 1},
      "grid": {"factors": [2, 4], "epochs": [2, 3]}
    },
    {
      "label": "confidence-als",
      "name": "confidence_als",
      "params": {"regularization": 0.1},
      "grid": {"factors": [2, 4], "epochs": [1, 2], "alpha": [10.0, 40.0]}
    },
    {
      "label": "ease",
      "name": "ease",
      "params": {"max_items": 256},
      "grid": {"regularization": [10.0, 100.0]}
    },
    {
      "label": "user-knn",
      "name": "user_knn",
      "params": {},
      "grid": {"neighbors": [2, 4], "shrinkage": [0.0, 1.0]}
    },
    {
      "label": "sequential-markov",
      "name": "sequential_markov",
      "params": {},
      "grid": {"weighted": [false, true], "popularity_mix": [0.0, 0.05]}
    }
  ]
}
