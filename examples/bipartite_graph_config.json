{
  "seed": 2026,
  "data": {"path": "bipartite_graph_interactions.json"},
  "split": {"method": "leave_one_out"},
  "model": {
    "name": "bipartite_graph_bpr",
    "params": {"factors": 2, "layers": 1, "epochs": 4, "learning_rate": 0.1}
  },
  "evaluation": {"k": 2, "exclude_seen": true},
  "output": {
    "model_path": "../artifacts/bipartite-graph/model.json",
    "report_path": "../artifacts/bipartite-graph/report.json"
  }
}
