{
  "seed": 2026,
  "data": {
    "path": "interactions.json"
  },
  "split": {
    "method": "leave_one_out",
    "test_ratio": 0.2
  },
  "model": {
    "name": "ease",
    "params": {
      "regularization": 10.0,
      "max_items": 64,
      "max_work_units": 1000000
    }
  },
  "evaluation": {
    "k": 3,
    "exclude_seen": true
  },
  "output": {
    "model_path": "../artifacts/ease/model.json",
    "report_path": "../artifacts/ease/report.json"
  }
}
