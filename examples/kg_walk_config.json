{
  "seed": 2026,
  "data": {
    "path": "kg_walk_interactions.json",
    "knowledge_path": "../artifacts/kg-walk/knowledge.json"
  },
  "split": {"method": "leave_one_out", "test_ratio": 0.2},
  "model": {
    "name": "kg_walk_rec",
    "params": {"hops": 2, "relation_weights": {"r": 2, "q": 1}, "popularity_mix": 0.05}
  },
  "evaluation": {"k": 2, "exclude_seen": true},
  "output": {
    "model_path": "../artifacts/kg-walk/model.json",
    "report_path": "../artifacts/kg-walk/report.json"
  }
}
