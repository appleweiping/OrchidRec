{
  "seed": 2026,
  "data": {"path": "interactions.json"},
  "split": {"method": "leave_one_out", "test_ratio": 0.2},
  "model": {"name": "item_knn", "params": {"neighbors": 4, "shrinkage": 1.0}},
  "evaluation": {
    "k": 3,
    "exclude_seen": true,
    "sampling": {"strategy": "uniform", "negatives": 3}
  }
}
