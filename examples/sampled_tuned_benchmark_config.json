  "tuning": {
    "selection_metric": "ndcg",
    "direction": "maximize",
    "validation_split": {"method": "leave_one_out", "validation_ratio": 0.2},
    "implicit_mf_seeds": [2026]
  },
  "models": [
    {"label": "popularity", "name": "popularity", "params": {}, "grid": {"weighted": [false, true]}},
    {"label": "item-knn", "name": "item_knn", "params": {"neighbors": 4}}
  ]
}
