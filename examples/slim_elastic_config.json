{
  "seed": 2026,
  "data": {"path": "interactions.json"},
  "split": {"method": "leave_one_out", "test_ratio": 0.2},
  "model": {
    "name": "slim_elastic",
    "params": {
      "l1": 0.2,
      "l2": 0.3,
      "max_sweeps": 100,
      "tolerance": 0.0000001,
      "max_items": 96,
      "max_work_units": 200000000
    }
  },
  "evaluation": {"k": 3, "exclude_seen": true},
  "output": {
    "model_path": "../artifacts/slim-elastic/model.json",
    "report_path": "../artifacts/slim-elastic/report.json"
  }
}
