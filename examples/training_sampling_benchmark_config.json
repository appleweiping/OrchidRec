{
  "schema_version": 1,
  "seed": 2026,
  "data": {"path": "training_sampling_interactions.json", "format": "orchidrec-json"},
  "split": {"method": "leave_one_out"},
  "evaluation": {"k": 2, "exclude_seen": true, "bootstrap_samples": 20},
  "models": [
    {"label": "uniform", "name": "bipartite_graph_bpr", "params": {"factors": 2, "epochs": 4}},
    {"label": "popularity", "name": "bipartite_graph_bpr", "params": {"factors": 2, "epochs": 4, "negative_strategy": "popularity", "popularity_alpha": 1.0}}
  ]
}
