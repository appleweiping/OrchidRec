{
  "seed": 2026,
  "data": {"path": "training_sampling_interactions.json"},
  "split": {"method": "leave_one_out"},
  "model": {
    "name": "bipartite_graph_bpr",
    "params": {"factors": 2, "layers": 1, "epochs": 4, "negative_strategy": "popularity", "popularity_alpha": 1.0}
  },
  "evaluation": {"k": 2, "exclude_seen": true},
  "output": {
    "model_path": "../artifacts/training-sampling/model.json",
    "report_path": "../artifacts/training-sampling/report.json"
  }
}
